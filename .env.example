# ---------------------------------------------------------------------------
# Local development environment variables.
#
# Copy to .env: `cp .env.example .env` -- the defaults below (DEMO_MODE=true,
# DISABLE_AUTH=true, everything else blank) run the ENTIRE app with zero
# Azure account and zero cost: local keyword retrieval over the bundled
# sample docs stands in for Azure OpenAI + AI Search (see app/rag/demo.py).
# `docker compose up --build` and you're chatting with it.
#
# To run against the real Azure services instead: set DEMO_MODE=false,
# DISABLE_AUTH=false, and fill in the AZURE_*/ENTRA_* values below (from
# `infra/deploy.sh` and `infra/register_entra_apps.sh` output). In Azure
# itself none of this is set as plain env vars -- Container Apps injects it
# via Key Vault references + Managed Identity; see infra/main.bicep.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO
DEMO_MODE=true

# --- Azure OpenAI (ignored while DEMO_MODE=true) -----------------------------
AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-10-21
# Only used for local dev without az login; production uses Managed Identity.
AZURE_OPENAI_API_KEY=

# --- Azure AI Search (ignored while DEMO_MODE=true) --------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=enterprise-rag-index
AZURE_SEARCH_API_KEY=

# --- Azure Blob Storage (ignored while DEMO_MODE=true) -----------------------
AZURE_STORAGE_ACCOUNT_URL=https://<yourstorageacct>.blob.core.windows.net
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents
AZURE_STORAGE_CONTAINER_COST=cost-exports
AZURE_STORAGE_CONNECTION_STRING=

# --- Entra ID (Azure AD) ------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=api://<api-client-id>
ENTRA_ALLOWED_GROUPS=
# Frontend (public client) values, consumed by the React app at build time.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_API_SCOPE=api://<api-client-id>/access_as_user
VITE_API_BASE_URL=http://localhost:8000

# --- Key Vault ----------------------------------------------------------------
AZURE_KEY_VAULT_URL=https://<your-keyvault>.vault.azure.net/

# --- Application Insights ------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Cost tracking --------------------------------------------------------------
# USD per 1K tokens, override to match your negotiated/region pricing.
COST_INPUT_PER_1K_TOKENS=0.0025
COST_OUTPUT_PER_1K_TOKENS=0.01
COST_EMBEDDING_PER_1K_TOKENS=0.00013
COST_BUDGET_MONTHLY_USD=200
COST_ALERT_WEBHOOK_URL=

# --- Auth bypass for local dev only (never set in Azure) -----------------------
DISABLE_AUTH=true
